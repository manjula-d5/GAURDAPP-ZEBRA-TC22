<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allow cleartext (HTTP) for LAN / dev-server access.
        Android treats <domain> entries as exact hostnames, not subnets,
        so we use a base-config to cover any private IP the server might have.
        Production builds should switch to HTTPS and remove this base-config.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
